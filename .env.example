# Signs the session cookie. Set it in your host's environment settings to any
# random string of 16+ characters, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the app falls back to a built-in demo secret (fine locally, not in
# production). Never commit a real value.
AUTH_SECRET=

# Optional. The desk works fully without any key: every number and decision
# is calculated in code. A key only lets a language model reword chat answers.
# Set ONE of these. Never commit a real key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
