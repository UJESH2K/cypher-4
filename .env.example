# Copy to .env.local for local development, and set the same values in your
# host's environment settings (e.g. Vercel > Settings > Environment Variables).
# Never commit real values; .env.local is git-ignored.

# Database (Supabase). Server-only: never prefix these with NEXT_PUBLIC_.
# SUPABASE_URL: Project Settings > API > Project URL.
# SUPABASE_SECRET_KEY: Project Settings > API Keys > secret key (sb_secret_...).
# Without them the app still runs, using the built-in sample in each browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs the session cookie. Any random string of 16+ characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional. A key only lets a language model reword chat answers; every number
# and decision is calculated in code. Set ONE of these.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
